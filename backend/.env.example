# Keep secrets in this backend-only file. Never commit backend/.env.
GEMINI_API_KEY=
# Set true on a public demo to block uploads, activation and intervention writes.
DEMO_READ_ONLY=false
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATLAS_DB_PATH=../atlas_state.sqlite3
